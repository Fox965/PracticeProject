<header class="flex justify-between items-center w-full">
    <a href="/" class="flex gap-x-4 items-center">
        <div>
            <img src="assets/logo.png" alt="logo">
        </div>
        <span class="text-xl xl:text-3xl leading-10 hidden lg:inline">Book knight</span>
    </a>
    <nav class="lg:flex gap-x-2 xl:gap-x-5 list-none text-xl xl:text-2xl hidden">

        <!--МЕНЮ-->
        {{#each nav}}

            <li>
                <a href="{{this.url}}">{{this.name}}</a>
            </li>

        {{/each}}

    </nav>

    <!--МОБИЛЬНОЕ МЕНЮ-->
    <div id="burger" class="lg:hidden cursor-pointer absolute z-50 top-[35px] right-[31px]">
        <div id="bar-1" class="w-[25px] h-[2px] bg-[#343434] my-2 transition-[.4s]"></div>
        <div id="bar-2" class="w-[25px] h-[2px] bg-[#343434] my-2 transition-[.4s]"></div>
        <div id="bar-3" class="w-[25px] h-[2px] bg-[#343434] my-2 transition-[.4s]"></div>
    </div>
    <nav id="mobile-menu" class="lg:hidden absolute z-10 flex flex-col gap-y-3 list-none top-0 right-0 translate-x-full transition-transform duration-300 ease-in-out h-screen bg-white pt-24 pl-5 pr-8 text-lg text-[#4B4844]">
        {{#each nav}}

            <li>
                <a href="{{this.url}}">{{this.name}}</a>
            </li>

        {{/each}}
        <li>
            <a href="/korzina">Корзина</a>
        </li>
        {{#if user.user}}
            <li>
                <a href="/account">Профиль</a>
            </li>
        {{else}}
            <li>
                <a href="/auth">Профиль</a>
            </li>
        {{/if}}
    </nav>

    <div class="lg:flex gap-x-5 xl:gap-x-11 relative hidden">
        <a href="/korzina" class="flex-center w-[70px] h-[70px] bg-gradient-to-b from-[#6183DD] to-[#344777] rounded-full">
            <img src="assets/basket-icon.svg" alt="basket">
        </a>
        <div id="user-button" class="flex gap-6 items-center cursor-pointer">
            <button class="flex-center w-[70px] h-[70px] bg-gradient-to-b from-[#6183DD] to-[#344777] rounded-full">
                <img src="assets/user-icon.svg" alt="user">
            </button>
            <svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14.0408 1L7.23689 8.52066L1 1" stroke="black" stroke-width="0.5"/>
            </svg>
        </div>
        <div id="hidden-user" class="absolute hidden dropdown px-3 py-14 list-none z-10 top-20 right-0">
            {{#if user.user}}
                {{#ifCond user.user '===' "admin"}}
                    <li class="text-main-yellow text-lg font-medium">
                        <a href="/account">личный кабинет</a>
                    </li>
                    <li class="text-main-yellow text-lg font-medium">
                        <a href="/admin">админ панель</a>
                    </li>
                    <li class="text-main-yellow text-lg font-medium">
                        <a href="/auth">выйти</a>
                    </li>
                {{else}}
                    <li class="text-main-yellow text-lg font-medium">
                        <a href="/account">личный кабинет</a>
                    </li>
                    <li class="text-main-yellow text-lg font-medium">
                        <a href="/auth">выйти</a>
                    </li>
                {{/ifCond}}
            {{else}}
                <li class="text-main-yellow text-lg font-medium">
                    <a href="/auth">Войти</a>
                </li>
            {{/if}}
        </div>
    </div>
</header>