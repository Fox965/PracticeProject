                                <button id="plus" class="py-4 px-10 h-full text-[#C9C9C9] duration-300 hover:bg-zinc-200 hover:text-black">+</button>
                            </div>
                            <button class="button-style-1 rounded-[5px] py-5 px-[89px]">
